{
  "uid": "mcp-tools",
  "title": "MCP 도구 호출 (control-plane)",
  "tags": ["ai-ops", "control-plane", "mcp"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "도구별 호출 빈도 (5분 창)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (increase(mcp_tool_calls_seconds_count{job=\"control-plane\"}[5m]))",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "도구별 평균 응답 시간",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (rate(mcp_tool_calls_seconds_sum{job=\"control-plane\"}[5m])) / sum by (tool) (rate(mcp_tool_calls_seconds_count{job=\"control-plane\"}[5m]))",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "outcome 분포 — degraded 는 error 필드 강등 응답 (isError:false 관례)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(mcp_tool_calls_seconds_count{job=\"control-plane\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "비정상 비율 (degraded+failure, 15분 창)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mcp_tool_calls_seconds_count{job=\"control-plane\", outcome!=\"success\"}[15m])) / sum(increase(mcp_tool_calls_seconds_count{job=\"control-plane\"}[15m]))",
          "legendFormat": "비정상 비율"
        }
      ]
    }
  ]
}

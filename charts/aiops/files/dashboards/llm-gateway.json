{
  "uid": "llm-gateway",
  "title": "LLM 게이트웨이 (llm-gateway)",
  "tags": [
    "aiops",
    "llm-gateway"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "캐시 히트율 (1시간 창, bypass 제외)",
      "description": "히트율 = (정확 + 의미 히트) / (전체 - bypass). tool calling·no-cache 요청은 분모에서 제외 — 캐싱 대상이 아니라서 (llm-gateway/README 분류 기준)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "noValue": "요청 없음"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(gateway_cache_requests_total{result=~\"exact_hit|semantic_hit\"}[1h])) / sum(increase(gateway_cache_requests_total{result!=\"bypass\"}[1h]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "절감 비용 (누적, USD) — 게이트웨이 기록",
      "description": "캐시 히트로 아낀 금액 — 단가는 gateway.cost.prices (yml 외부화) 단일 원천",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "noValue": "$0"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(gateway_cost_saved_usd_total) or vector(0)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "캐시 판정 분포 (5분 창)",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (increase(gateway_cache_requests_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "절감 토큰 누적 (모델·종류별)",
      "description": "캐시 적중 시 재계산 없이 반환된 응답의 usage — kind=prompt/completion 구분 (completion 단가가 5배라 비용 기여 상이)",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, kind) (gateway_cache_saved_tokens_total)",
          "legendFormat": "{{model}} {{kind}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "태스크·모델별 요청 (5분 창) — 라우팅 실측",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task, model) (increase(gateway_requests_total[5m]))",
          "legendFormat": "{{task}} → {{model}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "오늘 실지출 (UTC 24h, USD)",
      "description": "예산 판정 기준은 게이트웨이 Redis 카운터(UTC 일별) — 이 패널은 Prometheus 근사",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(gateway_cost_usd_total[24h])) or vector(0)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "서비스별 지출 (1시간 창, USD)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (service) (increase(gateway_cost_usd_total[1h]))",
          "refId": "A",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "X-Client-Service 차원 — 원장(llm_cost_ledger)의 일별 정밀 집계는 psql"
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "예산 다운그레이드·429 (5분 창)",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (service) (increase(gateway_budget_downgrades_total[5m]))",
          "refId": "A",
          "legendFormat": "downgrade {{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (service) (increase(gateway_ratelimit_rejected_total[5m]))",
          "refId": "B",
          "legendFormat": "429 {{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "예산 100% 도달 시 저비용 모델 강제 전환 횟수 + 분당 한도 초과 거절 횟수"
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "레이턴시 분위수 (5분 창) — 캐시 히트 vs 미스 분리",
      "description": "gateway_latency 히스토그램 — miss 는 프로바이더 왕복 포함, hit 은 캐시 반환. bypass 는 표본이 달라 제외",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gateway_latency_seconds_bucket{result=\"miss\"}[5m])))",
          "legendFormat": "miss p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gateway_latency_seconds_bucket{result=\"miss\"}[5m])))",
          "legendFormat": "miss p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gateway_latency_seconds_bucket{result=\"miss\"}[5m])))",
          "legendFormat": "miss p99"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gateway_latency_seconds_bucket{result=~\"exact_hit|semantic_hit\"}[5m])))",
          "legendFormat": "hit p50"
        },
        {
          "refId": "E",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gateway_latency_seconds_bucket{result=~\"exact_hit|semantic_hit\"}[5m])))",
          "legendFormat": "hit p95"
        },
        {
          "refId": "F",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gateway_latency_seconds_bucket{result=~\"exact_hit|semantic_hit\"}[5m])))",
          "legendFormat": "hit p99"
        }
      ]
    },
    {
      "id": 10,
      "type": "gauge",
      "title": "오늘 예산 소진율 (이동 24h 근사)",
      "description": "분모는 gateway_budget_daily_limit_usd 게이지 (yml 단일 원천 — 하드코딩 아님). 80% = Slack 경고, 100% = 다운그레이드. 판정 실물은 게이트웨이 Redis 카운터(UTC 일별) — 이 패널은 이동 24h 근사",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 120,
          "decimals": 1,
          "noValue": "지출 없음",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(increase(gateway_cost_usd_total[24h])) / max(gateway_budget_daily_limit_usd)"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "예산 Slack 경고 채널",
      "description": "0 = SLACK_WEBHOOK_URL 미설정 (경고는 로그 대체) — \"왜 경고가 안 오지\"의 대시보드 판",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "게이트웨이 다운",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "비활성 (로그 대체)",
                  "color": "orange"
                },
                "1": {
                  "text": "활성",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(gateway_alert_slack_enabled)"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "폴백 발생 (5분 창)",
      "description": "주 프로바이더 장애로 교차 재중계(target=openai)·로컬 폴백(target=local)한 요청 수 (폴백 체인)",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "폴백 없음"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (from, target) (increase(gateway_fallback_total[5m]))",
          "legendFormat": "{{from}} → {{target}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "서킷 브레이커 상태 — replica 별 (합산 금지)",
      "description": "서킷 상태는 replica 로컬(in-memory) — 각 pod 이 독립적으로 열고 닫으므로 합산이 아니라 개별 시계열로 본다 (sum 은 \"열린 replica 수\"라는 다른 지표가 된다). 값 1 = 해당 상태",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "noValue": "게이트웨이 다운"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "resilience4j_circuitbreaker_state{state=~\"open|half_open\"}",
          "legendFormat": "{{name}} {{state}} — {{pod}}{{instance}}"
        }
      ]
    }
  ]
}
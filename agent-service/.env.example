# LLM — 모든 호출은 llm-gateway 경유 (ADR-0015). 프로바이더 실키는 게이트웨이만 보유 —
# 여기엔 키가 필요 없다 (LLM_API_KEY 는 미검증 자리 표시, 인증 전파는 보안 주간).
# LLM_CLIENT 는 와이어 프로토콜(게이트웨이의 OpenAI 호환 표면)이지 모델의 프로바이더가 아니다.
# LLM_DEFAULT_MODEL 은 게이트웨이 별칭 — "default" = 게이트웨이의 default 라우팅 규칙.
# 모델 선택은 전부 게이트웨이 소관이라 여기엔 프로바이더 모델명이 등장하지 않는다
LLM_CLIENT=openai
LLM_DEFAULT_MODEL=default
LLM_BASE_URL=http://localhost:8090/v1

# 관측 스택 — 직접 조회 (ADR-0002). 로컬 개발 기준 호스트 포트.
# 컨테이너로 실행 시 http://prometheus:9090 / http://loki:3100
PROMETHEUS_URL=http://localhost:9091
LOKI_URL=http://localhost:3100

# LangGraph 체크포인트 (ADR-0009). 로컬 개발 기준 호스트 포트 (5432 는 타 PostgreSQL 점유 → 5433).
# 컨테이너로 실행 시 compose 가 postgresql://aiops:aiops@postgres:5432/aiops 로 덮어쓴다
CHECKPOINT_DB_URL=postgresql://aiops:aiops@localhost:5433/aiops

# Kafka 인시던트 컨슈머 (DAY 18, ADR-0011). 로컬 개발 기준 호스트 리스너 (EXTERNAL).
# 컨테이너로 실행 시 compose 가 kafka:9092 로 덮어쓴다. 빈 값이면 컨슈머 비활성 (수동 트리거만)
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# MCP 도구 서버 인증 (ADR-0016) — auth-server Client Credentials. 시크릿은 infra/.env 의
# AUTH_CLIENT_SECRET_AGENT_SERVICE 와 같은 값 (필수 — 미설정 시 기동 실패). 로컬 개발 기준 호스트 포트,
# 컨테이너로 실행 시 compose 가 http://auth-server:8091/oauth2/token 로 덮어쓴다
AUTH_TOKEN_URL=http://localhost:8091/oauth2/token
AUTH_CLIENT_SECRET=

# OTLP 트레이스·메트릭 전송 (DAY 42) — Collector 주소. 미설정 = 전파·계측만(전송 없음). 컨테이너로 실행 시 compose 가
# http://otel-collector:4318 로 덮어쓴다. 호스트 실행 중 compose 의 Collector 로 보내려면 아래를 켠다.
# Langfuse 는 Collector 가 라우팅한다 — 앱에 Langfuse 키는 필요 없다 (키는 infra/.env 의 Collector 몫)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# 프롬프트/응답 본문 캡처 (DAY 43, docs/otel-genai-mapping.md §6) — 미설정 = NO_CONTENT. 마스킹 전 원문이 나가므로
# 로컬에서 Langfuse 입출력을 보고 싶을 때만 켠다 (compose 는 SPAN_ONLY 로 설정됨)
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_ONLY

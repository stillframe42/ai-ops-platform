# LLM — "프로바이더:모델" 형식 (ADR-0007). 활성 프로바이더의 API 키만 있으면 된다.
LLM_MODEL=anthropic:claude-sonnet-5
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...          # LLM_MODEL=openai:gpt-5.6-terra 전환 시

# 관측 스택 — 직접 조회 (ADR-0002). 로컬 개발 기준 호스트 포트.
# 컨테이너로 실행 시 http://prometheus:9090 / http://loki:3100
PROMETHEUS_URL=http://localhost:9091
LOKI_URL=http://localhost:3100

# LangGraph 체크포인트 (ADR-0009). 로컬 개발 기준 호스트 포트 (5432 는 타 PostgreSQL 점유 → 5433).
# 컨테이너로 실행 시 compose 가 postgresql://aiops:aiops@postgres:5432/aiops 로 덮어쓴다
CHECKPOINT_DB_URL=postgresql://aiops:aiops@localhost:5433/aiops

# Langfuse (DAY 14 — aireviewer 스택 재활용, 본 프로젝트용 project 키)
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
